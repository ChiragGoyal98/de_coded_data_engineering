# Environment variables for content generation and automation

# Google AI Studio / Generative Language API key
GOOGLE_API_KEY=

# Google AI Studio endpoint for Gemini 3 Flash preview
GOOGLE_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent

# Telegram bot configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=-1001234567890

# Public site URL (GitHub Pages). Must match astro.config.mjs base path.
SITE_BASE_URL=https://chiraggoyal98.github.io/de_coded_data_engineering
