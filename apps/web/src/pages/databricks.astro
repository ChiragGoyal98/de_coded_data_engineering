---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Databricks | DE-Coded Lab" description="Databricks notebooks, Delta Lake, and jobs.">
  <div slot="hero" class="container hero-content">
    <p class="eyebrow">Databricks Learning</p>
    <h1>Notebook to production workflow on Databricks</h1>
    <p class="subtitle">Learn collaboration, Delta patterns, and automated jobs in one practical path.</p>
  </div>

  <section class="section-block">
    <h2>Notebook engineering</h2>
    <p>Structure notebooks so they are testable, reusable, and migration-ready for jobs.</p>
  </section>
  <section class="section-block">
    <h2>Delta Lake practices</h2>
    <p>Apply schema evolution, merge patterns, and lifecycle operations safely at scale.</p>
  </section>
  <section class="section-block">
    <h2>Operational jobs</h2>
    <p>Schedule resilient workflows with observability and clean failure handling.</p>
  </section>
</BaseLayout>

