---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About | DE-Coded Lab" description="About DE-Coded Lab and its mission.">
  <div slot="hero" class="container hero-content">
    <p class="eyebrow">About the Project</p>
    <h1>DE-Coded Lab is a practical learning journal for data engineers</h1>
    <p class="subtitle">Built to publish consistent, useful, code-forward content that helps learners ship real work.</p>
  </div>

  <section class="section-block">
    <h2>Mission</h2>
    <p>Deliver high-signal tutorials and explain complex data engineering ideas in a simple, implementation-ready format.</p>
  </section>
  <section class="section-block">
    <h2>Publishing model</h2>
    <p>Every 8 hours, a workflow generates a new tutorial and a fresh briefing, then pushes updates to Telegram.</p>
  </section>
</BaseLayout>

