---
import BaseLayout from "../layouts/BaseLayout.astro";
import { cleanHeadline, loadSiteContent, newsPreview } from "../lib/siteContent";

const { news } = loadSiteContent();
---

<BaseLayout title="News Briefs | DE-Coded Lab" description="Periodic data engineering news briefings.">
  <div slot="hero" class="container hero-content">
    <p class="eyebrow">Periodic Briefing</p>
    <h1>Data engineering news stream</h1>
    <p class="subtitle">Fresh briefings are generated each content cycle and linked from Telegram.</p>
  </div>

  <section class="section-block">
    <div class="content-list">
      {
        news.length ? (
          news.map((item) => (
            <article class:list={["content-card", { "highlight-new": item.is_new }]}>
              {item.is_new ? <span class="badge-new">NEW</span> : null}
              <h3>{cleanHeadline(item.headline || "News brief")}</h3>
              {item.body ? <p>{newsPreview(item.body)}</p> : null}
              {item.published ? <p class="news-date">{item.published}</p> : null}
            </article>
          ))
        ) : (
          <p>No news briefs yet. Run the pipeline to publish a cycle.</p>
        )
      }
    </div>
  </section>

  <style>
    .badge-new {
      display: inline-block;
      margin-bottom: 0.5rem;
      padding: 0.15rem 0.5rem;
      border-radius: 999px;
      background: #0a7f58;
      color: #fff;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.04em;
    }
    .highlight-new {
      border-color: #0a7f58;
    }
    .news-date {
      margin-top: 0.75rem;
      color: #6b7280;
      font-size: 0.85rem;
    }
  </style>
</BaseLayout>
