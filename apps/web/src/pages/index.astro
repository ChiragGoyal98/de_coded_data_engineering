---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  articleHref,
  articleSearchText,
  cleanArticleSummary,
  loadSiteContent,
} from "../lib/siteContent";

const base = import.meta.env.BASE_URL;
const { articles: allArticles } = loadSiteContent();
const initialVisibleCount = 8;
---

<BaseLayout
  title="DE-Coded Lab"
  description="Automated data engineering tutorials, news, and API-focused guides."
>
  <div slot="hero" class="container hero-content">
    <p class="eyebrow">Automated Data Engineering Journal</p>
    <h1>How practical data engineers learn, practice, and ship real portfolio work.</h1>
    <p class="subtitle">
      DE-Coded Lab publishes fresh content every 8 hours across Python, SQL, PySpark, Azure,
      Databricks, and LLM APIs with a community-first Telegram distribution loop.
    </p>
    <div class="hero-buttons">
      <a class="btn primary" href="https://t.me/DE_Coded_Data_Engineering" target="_blank">Join Telegram Group</a>
      <a class="btn secondary" href={`${base}coding`}>Start Learning</a>
    </div>
    <div class="chip-row">
      <span class="chip">Azure</span>
      <span class="chip">Databricks</span>
      <span class="chip">PySpark</span>
      <span class="chip">SQL</span>
      <span class="chip">LLM APIs</span>
    </div>
  </div>

  <section id="learn" class="section-block">
    <p class="eyebrow">Learn</p>
    <h2>Structured learning paths</h2>
    <div class="grid">
      <article class="card">
        <h2>DE Fundamentals</h2>
        <p>Core concepts, pipelines, storage layers, and orchestration mindset for beginners.</p>
        <a class="link-button" href={`${base}coding`}>Start path</a>
      </article>
      <article class="card">
        <h2>SQL + Python + PySpark</h2>
        <p>Querying, scripting, and distributed transformations with practical ETL patterns.</p>
        <a class="link-button" href={`${base}coding`}>Open path</a>
      </article>
      <article class="card">
        <h2>Cloud + Lakehouse</h2>
        <p>Azure architecture, Databricks jobs, and production-grade data platform patterns.</p>
        <a class="link-button" href={`${base}azure`}>Explore path</a>
      </article>
      <article class="card">
        <h2>AI in Data Engineering</h2>
        <p>LLM API integration, SDK wrappers, and reliability patterns for data workflows.</p>
        <a class="link-button" href={`${base}apis`}>Read playbook</a>
      </article>
    </div>
  </section>

  <section id="practice" class="section-block">
    <p class="eyebrow">Practice</p>
    <h2>Practice formats that compound your skills</h2>
    <div class="feature-grid">
      <article class="content-card">
        <h3>Coding Drills</h3>
        <p>Short SQL, Python, and PySpark exercises built around interview-style patterns.</p>
      </article>
      <article class="content-card">
        <h3>Data Modeling</h3>
        <p>Star schema design, dimension modeling, and warehouse modeling walkthroughs.</p>
      </article>
      <article class="content-card">
        <h3>Architecture Prompts</h3>
        <p>System design scenarios for ingestion, streaming, governance, and observability.</p>
      </article>
    </div>
  </section>

  <section id="resources" class="section-block">
    <p class="eyebrow">Resources</p>
    <h2>Projects and implementation guides</h2>
    <article class="card">
      <h2>Azure Pipeline Project</h2>
      <p>Build ingestion + transform + warehouse flow using Data Factory, Databricks, and Synapse.</p>
    </article>
    <article class="card">
      <h2>LLM Content Automation Project</h2>
      <p>Create a recurring content engine using Gemini API, static publishing, and Telegram delivery.</p>
    </article>
    <article class="card">
      <h2>Databricks ETL Project</h2>
      <p>Implement bronze-silver-gold transformations with Delta constraints and scheduled jobs.</p>
    </article>
    <article class="card">
      <h2>Interview Readiness Kit</h2>
      <p>Topic-wise question sets and guided revision loops for DE interviews.</p>
    </article>
  </section>

  <section class="section-block stats-row">
    <article class="stat-card"><p class="stat-value">8h</p><p>Publishing cadence</p></article>
    <article class="stat-card"><p class="stat-value">5+</p><p>Topic domains</p></article>
    <article class="stat-card"><p class="stat-value">24/7</p><p>Telegram distribution</p></article>
    <article class="stat-card"><p class="stat-value">100%</p><p>Hands-on focus</p></article>
  </section>

  <section class="section-block">
    <h2>Latest generated articles</h2>
    <div class="search-container">
      <input
        type="text"
        id="article-search"
        placeholder="Search tutorials by title, category, or summary..."
        class="search-input"
      />
    </div>
    <div id="latest-articles-list" class="content-list">
      {
        allArticles.length ? (
          allArticles.map((article, index) => (
            <article
              class:list={[
                "content-card",
                "article-feed-card",
                { "highlight-new": article.is_new, "is-initially-hidden": index >= initialVisibleCount },
              ]}
              data-search={articleSearchText(article)}
              hidden={index >= initialVisibleCount}
            >
              {article.is_new ? <span class="badge-new">NEW</span> : null}
              {article.category ? <span class="pill">{article.category}</span> : null}
              <h3>{article.title}</h3>
              <p>{cleanArticleSummary(article.summary)}</p>
              <a class="link-button" href={articleHref(base, article)}>
                Read article
              </a>
            </article>
          ))
        ) : (
          <p>No articles yet. Run the content pipeline to publish the first tutorial.</p>
        )
      }
    </div>
    {
      allArticles.length > initialVisibleCount ? (
        <p class="feed-note">
          Showing {initialVisibleCount} of {allArticles.length} tutorials. Use search to find older articles.
        </p>
      ) : null
    }
  </section>

  <style>
    .search-container {
      margin-bottom: 2rem;
    }
    .search-input {
      width: 100%;
      max-width: 500px;
      padding: 0.8rem 1.2rem;
      border: 2px solid #eaeaea;
      border-radius: 8px;
      font-size: 1rem;
      transition: border-color 0.2s;
    }
    .search-input:focus {
      outline: none;
      border-color: #0078d4;
    }
    .feed-note {
      margin-top: 1rem;
      color: #6b7280;
      font-size: 0.9rem;
    }
    .badge-new {
      display: inline-block;
      margin-bottom: 0.5rem;
      padding: 0.15rem 0.5rem;
      border-radius: 999px;
      background: #0a7f58;
      color: #fff;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.04em;
    }
    .highlight-new {
      border-color: #0a7f58;
    }

    :global(.code-container) {
      position: relative;
      margin: 1.5rem 0;
      border: 1px solid #e1e4e8;
      border-radius: 6px;
      overflow: hidden;
    }
    :global(.copy-button) {
      position: absolute;
      top: 0.5rem;
      right: 0.5rem;
      z-index: 10;
      padding: 0.4rem 0.8rem;
      font-size: 0.75rem;
      font-weight: 600;
      cursor: pointer;
      background: #ffffff;
      border: 1px solid #d1d5da;
      border-radius: 4px;
    }
    :global(.copy-button:hover) {
      background-color: #f3f4f6;
    }
    :global(pre) {
      margin: 0 !important;
      padding: 1.2rem !important;
      background: #f6f8fa;
      overflow-x: auto;
    }
  </style>

  <section class="section-block">
    <h2>FAQ</h2>
    <div class="faq-list">
      <details>
        <summary>Who is this for?</summary>
        <p>Anyone preparing for data engineering roles or building practical cloud data skills.</p>
      </details>
      <details>
        <summary>How often does content update?</summary>
        <p>The pipeline generates and publishes new content every 8 hours.</p>
      </details>
      <details>
        <summary>Do I need advanced prerequisites?</summary>
        <p>No. Start with fundamentals and move toward project-level implementation.</p>
      </details>
    </div>
  </section>

  <script define:vars={{ initialVisibleCount }}>
    window.copyCode = function (button) {
      const pre = button.nextElementSibling;
      const code = pre?.querySelector("code");
      if (!code) return;
      navigator.clipboard.writeText(code.innerText).then(() => {
        button.textContent = "Copied!";
        setTimeout(() => {
          button.textContent = "Copy";
        }, 2000);
      });
    };

    const contentList = document.getElementById("latest-articles-list");
    const searchInput = document.getElementById("article-search");
    if (!contentList || !searchInput) return;

    const cards = Array.from(contentList.querySelectorAll(".article-feed-card"));

    function renderVisibleCards(visibleCards) {
      cards.forEach((card) => {
        card.hidden = !visibleCards.includes(card);
      });

      const emptyState = contentList.querySelector(".search-empty");
      if (emptyState) emptyState.remove();

      if (!visibleCards.length) {
        const fallback = document.createElement("p");
        fallback.className = "search-empty";
        fallback.textContent = "No articles found matching your search.";
        contentList.appendChild(fallback);
      }
    }

    searchInput.addEventListener("input", (event) => {
      const searchTerm = event.target.value.toLowerCase().trim();
      if (!searchTerm) {
        cards.forEach((card, index) => {
          card.hidden = index >= initialVisibleCount;
        });
        const emptyState = contentList.querySelector(".search-empty");
        if (emptyState) emptyState.remove();
        return;
      }

      const filtered = cards.filter((card) =>
        (card.dataset.search || "").includes(searchTerm),
      );
      renderVisibleCards(filtered);
    });
  </script>
</BaseLayout>
