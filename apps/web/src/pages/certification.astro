---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Certification | DE-Coded Lab" description="Certification preparation for data engineering roles.">
  <div slot="hero" class="container hero-content">
    <p class="eyebrow">Certification Prep</p>
    <h1>Prepare for Azure and Databricks exams with practical depth</h1>
    <p class="subtitle">Use focused study paths that connect concepts to real project delivery.</p>
  </div>

  <section class="section-block">
    <h2>Skill-mapped roadmaps</h2>
    <p>Track ingestion, transformation, orchestration, and governance topics by exam blueprint.</p>
  </section>
  <section class="section-block">
    <h2>Practice-first routine</h2>
    <p>Convert each topic to one executable task so progress is measurable every weekend.</p>
  </section>
</BaseLayout>

