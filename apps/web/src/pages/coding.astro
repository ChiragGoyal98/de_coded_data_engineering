---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Programming | DE-Coded Lab" description="Python, PySpark, SQL, and OOP for data engineers.">
  <div slot="hero" class="container hero-content">
    <p class="eyebrow">Programming for Data Engineering</p>
    <h1>Python, PySpark, SQL, and OOP foundations</h1>
    <p class="subtitle">Hands-on learning paths that map directly to practical ETL work.</p>
  </div>

  <section class="section-block">
    <h2>Python for ETL</h2>
    <p>Build scripts that read, transform, validate, and publish data in repeatable jobs.</p>
  </section>
  <section class="section-block">
    <h2>PySpark for scale</h2>
    <p>Learn DataFrame operations, joins, aggregations, and writing optimized transformations.</p>
  </section>
  <section class="section-block">
    <h2>SQL for analytics engineering</h2>
    <p>Model and query data with CTEs, window functions, and warehouse-ready practices.</p>
  </section>
</BaseLayout>

